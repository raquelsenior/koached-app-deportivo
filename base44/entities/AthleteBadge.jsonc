{
  "name": "AthleteBadge",
  "type": "object",
  "properties": {
    "athlete_id": {
      "type": "string"
    },
    "athlete_name": {
      "type": "string"
    },
    "badge_id": {
      "type": "string"
    },
    "unlocked_date": {
      "type": "string",
      "format": "date"
    }
  },
  "required": [
    "athlete_id",
    "badge_id"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": null,
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}