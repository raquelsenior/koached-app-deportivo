{
  "name": "TrainingLog",
  "type": "object",
  "properties": {
    "athlete_id": {
      "type": "string"
    },
    "athlete_name": {
      "type": "string"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "source": {
      "type": "string",
      "enum": [
        "manual",
        "strava",
        "garmin",
        "apple_watch",
        "gpx_file"
      ],
      "default": "manual"
    },
    "activity_type": {
      "type": "string",
      "enum": [
        "run",
        "bike",
        "swim",
        "strength",
        "walk",
        "other"
      ],
      "default": "run"
    },
    "title": {
      "type": "string"
    },
    "distance_km": {
      "type": "number"
    },
    "duration_min": {
      "type": "number"
    },
    "avg_pace_sec_km": {
      "type": "number"
    },
    "avg_hr": {
      "type": "number"
    },
    "max_hr": {
      "type": "number"
    },
    "elevation_gain_m": {
      "type": "number"
    },
    "calories": {
      "type": "number"
    },
    "rpe": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10
    },
    "notes": {
      "type": "string"
    },
    "gpx_file_url": {
      "type": "string"
    },
    "external_activity_id": {
      "type": "string"
    }
  },
  "required": [
    "athlete_id",
    "date",
    "activity_type"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}